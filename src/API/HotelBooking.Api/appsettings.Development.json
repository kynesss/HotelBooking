{
  "ConnectionStrings": {
    "Database": "Host=hotelbooking.database;Port=5432;Database=hotelbooking;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "Authentication": {
    "Audience": "account",
    "TokenValidationParameters": {
      "ValidIssuers": [
        "http://hotelbooking.identity:8080/realms/hotelbooking",
        "http://localhost:18080/realms/hotelbooking"
      ]
    },
    "MetadataAddress": "http://hotelbooking.identity:8080/realms/hotelbooking/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
